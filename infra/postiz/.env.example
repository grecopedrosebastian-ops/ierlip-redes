# Copiá este archivo a .env (instalar.sh lo hace solo y genera las claves).
# Nunca subas .env a git ni lo pegues en un chat.

# Subdominio que apunta al servidor (registro A en el DNS de estudioierlip.com).
DOMINIO=redes.estudioierlip.com
# Mail para los avisos de Let's Encrypt (certificado HTTPS).
EMAIL_ACME=tu-mail@ejemplo.com

# Se generan solos con instalar.sh. No los cambies después: JWT_SECRET cierra
# todas las sesiones y POSTGRES_PASSWORD tiene que coincidir con la base ya creada.
JWT_SECRET=
POSTGRES_PASSWORD=

# Después de crear tu usuario en Postiz, poné true y reiniciá (docker compose up -d).
DISABLE_REGISTRATION=false

# Instagram, opción A (recomendada): app de Meta con la página de Facebook vinculada a la cuenta.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram, opción B: Instagram "standalone" (cuenta profesional, sin página de Facebook).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok (app de TikTok for Developers con Login Kit + Content Posting API).
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# LinkedIn (opcional, para la página de la empresa).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
